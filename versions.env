# Pinned sources for the image. Bump these four lines together (see README "Bumping versions").
# Server: PGSTY Silo, the maintained community fork of the archived MinIO server.
MINIO_REPO=https://github.com/pgsty/silo.git
MINIO_TAG=RELEASE.2026-09-16T00-00-00Z
MINIO_COMMIT=2a4d51406b7ed87af5fe6fe0f801f3290f96eb3c
# Client: pgsty/mc, the matching fork of the MinIO Client (built here under its original name, mc).
MC_REPO=https://github.com/pgsty/mc.git
MC_TAG=RELEASE.2026-09-16T00-00-00Z
MC_COMMIT=e952aa78f10a2b77dd525a2b7e3143bcda0cd377
# Toolchain and runtime base. Keep GO_IMAGE at or above the `go` directive in both go.mod files.
GO_IMAGE=golang:1.27.1-alpine3.24
RUNTIME_IMAGE=alpine:3.24.2
